{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jitters-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "id", "payload"],
  "properties": {
    "v": { "const": 1 },
    "type": {
      "enum": [
        "hello",
        "hello.ack",
        "ping",
        "pong",
        "handoff.request",
        "handoff.accept",
        "handoff.ready",
        "handoff.commit",
        "handoff.ack",
        "handoff.abort",
        "handoff.offer",
        "handoff.decline",
        "handoff.return",
        "handoff.shown",
        "session.end",
        "error"
      ]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9-]{3,32}$" },
    "payload": { "type": "object" }
  }
}
